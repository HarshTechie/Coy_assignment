# API server
PORT=4000
NODE_ENV=development

# Folder containing profiles.json, user.json, swipes.json and matches.json.
# Relative paths are resolved from the server/ folder.
DATA_DIR=./data

# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGIN="http://localhost:5173"

# Expose POST /demo/reset so the UI can "start over" during demos.
# Automatically disabled when NODE_ENV=production.
ENABLE_DEMO_RESET=true
